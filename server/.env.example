DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-local-secret-change-later"
PORT=3010
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# URL фронта для return_url после оплаты (на проде — https://your-app.vercel.app)
PUBLIC_APP_URL="http://localhost:5173"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
# true = мгновенная демо-оплата без ЮKassa (только если ключи ЮKassa не заданы)
DEMO_PAYMENTS="true"
STARTING_BALANCE="10000"
# ЮKassa: https://yookassa.ru/my → Настройки → Магазин
# YOOKASSA_SHOP_ID=""
# YOOKASSA_SECRET_KEY=""
# Webhook в кабинете ЮKassa: https://<api-host>/api/payments/webhook
