generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum TopupStatus {
  pending
  paid
  failed
}

model User {
  id              String        @id @default(cuid())
  username        String        @unique
  passwordHash    String
  role            Role          @default(user)
  balance         Int           @default(10000)
  inventory       Json          @default("[]")
  chatMutedUntil  DateTime?
  chatMuteReason  String?
  createdAt       DateTime      @default(now())
  topups          Topup[]
  tickets         SupportTicket[]
  chatMessages    ChatMessage[]
  hostedBattles   BattleRoom[]  @relation("BattleHost")
}

enum BattlePrivacy {
  public
  private
}

enum BattleStatus {
  lobby
  running
  finished
  cancelled
}

enum BattlePhase {
  idle
  spinning
  revealed
}

/** Online case battle room — shared across clients. */
model BattleRoom {
  id             String        @id @default(cuid())
  inviteCode     String        @unique
  hostUserId     String
  host           User          @relation("BattleHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  privacy        BattlePrivacy @default(public)
  status         BattleStatus  @default(lobby)
  phase          BattlePhase   @default(idle)
  maxPlayers     Int
  /** 1 = free-for-all; 2 = 2v2; 3 = 3v3 */
  teamSize       Int           @default(1)
  caseIds        Json
  mode           String        @default("highest")
  fillBots       Boolean       @default(true)
  seed           String
  players        Json          @default("[]")
  drops          Json          @default("[]")
  currentRound   Int           @default(0)
  totalRounds    Int           @default(0)
  suddenDeath    Boolean       @default(false)
  winnerId       String?
  winnerTeamId   String?
  entryFee       Int           @default(0)
  phaseStartedAt DateTime?
  finishedAt     DateTime?
  payoutDone     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, privacy, createdAt])
  @@index([hostUserId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username   String
  body       String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Topup {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Int
  status            TopupStatus @default(pending)
  providerPaymentId String?
  createdAt         DateTime    @default(now())
  paidAt            DateTime?

  @@index([userId])
}

/** Singleton (id = "default"): ЮKassa credentials from admin UI. */
model PaymentSettings {
  id           String   @id @default("default")
  yooShopId    String?
  yooSecretKey String?
  publicAppUrl String?
  updatedAt    DateTime @updatedAt
}

enum SupportCategory {
  balance
  battle
  upgrade
  account
  other
}

enum SupportTicketStatus {
  open
  answered
  closed
}

enum SupportAuthorRole {
  user
  admin
  system
}

model SupportTicket {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  username  String
  category  SupportCategory
  subject   String
  status    SupportTicketStatus @default(open)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  messages  SupportMessage[]

  @@index([userId])
  @@index([status])
}

model SupportMessage {
  id         String            @id @default(cuid())
  ticketId   String
  ticket     SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  authorRole SupportAuthorRole
  body       String
  createdAt  DateTime          @default(now())

  @@index([ticketId])
}
